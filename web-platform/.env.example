# Configure actual values through the server's Secrets settings. Do not commit .env.
MFL_PLATFORM_PASSWORD=replace-with-a-long-private-lab-password
MFL_SESSION_SECRET=replace-with-at-least-32-random-characters
MFL_PUBLIC_URL=https://replace-with-your-service-host
MFL_COOKIE_SECURE=true
# Optional cloud model: must support vision and tools for unified mode.
MFL_API_BASE=
MFL_MODEL=
MFL_API_KEY=
MFL_UPLOAD_MB=64
